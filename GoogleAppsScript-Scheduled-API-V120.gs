/*
 * QE Elec. Daily Job Tracker V120 — Scheduled Summary API
 * Deploy as a standalone Google Apps Script Web App.
 *
 * Script Property required:
 *   QE_V120_SECRET = a long random secret (must match the Tracker and Power Automate)
 *
 * Deploy: Execute as Me / Who has access: Anyone.
 * This API stores the exact Morning and Evening text generated by the Tracker.
 * It does not contain a LINE token and does not send messages itself.
 */

var QE_V120 = (function () {
  "use strict";
  var PREFIX = "QE_V120_CACHE_";
  var CHUNK_SIZE = 7800;
  var MAX_AGE_MINUTES = 24 * 60;

  function output(value) {
    return ContentService.createTextOutput(JSON.stringify(value))
      .setMimeType(ContentService.MimeType.JSON);
  }
  function secret() {
    return String(PropertiesService.getScriptProperties().getProperty("QE_V120_SECRET") || "");
  }
  function safeEqual(a, b) {
    a = String(a || ""); b = String(b || "");
    if (!a || a.length !== b.length) return false;
    var diff = 0;
    for (var i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
    return diff === 0;
  }
  function authorized(value) {
    var configured = secret();
    return configured.length >= 12 && safeEqual(value, configured);
  }
  function parsePost(e) {
    try { return JSON.parse((e && e.postData && e.postData.contents) || "{}"); }
    catch (_) { return {}; }
  }
  function clearLarge(key) {
    var props = PropertiesService.getScriptProperties();
    var count = Number(props.getProperty(key + "_COUNT") || 0);
    for (var i = 0; i < count; i++) props.deleteProperty(key + "_" + i);
    props.deleteProperty(key + "_COUNT");
  }
  function setLarge(key, value) {
    var props = PropertiesService.getScriptProperties();
    clearLarge(key);
    var text = JSON.stringify(value);
    var count = Math.max(1, Math.ceil(text.length / CHUNK_SIZE));
    props.setProperty(key + "_COUNT", String(count));
    for (var i = 0; i < count; i++) {
      props.setProperty(key + "_" + i, text.slice(i * CHUNK_SIZE, (i + 1) * CHUNK_SIZE));
    }
  }
  function getLarge(key) {
    var props = PropertiesService.getScriptProperties();
    var count = Number(props.getProperty(key + "_COUNT") || 0);
    if (!count) return null;
    var text = "";
    for (var i = 0; i < count; i++) text += props.getProperty(key + "_" + i) || "";
    try { return JSON.parse(text); }
    catch (_) { return null; }
  }
  function normalizeLineBreaks(value) {
    return String(value == null ? "" : value)
      .replace(/<br\s*\/?>/gi, "\n")
      .replace(/\r\n?/g, "\n");
  }
  function cache(body) {
    if (!body.summaries || !body.summaries.morning || !body.summaries.evening) {
      return output({ ok: false, error: "summaries.morning and summaries.evening are required" });
    }
    var record = {
      version: String(body.version || "120"),
      timeZone: String(body.timeZone || "Asia/Bangkok"),
      sourceDate: String(body.sourceDate || ""),
      generatedAt: String(body.generatedAt || new Date().toISOString()),
      cachedAt: new Date().toISOString(),
      checksum: String(body.checksum || ""),
      summaries: {
        morning: normalizeLineBreaks(body.summaries.morning),
        evening: normalizeLineBreaks(body.summaries.evening)
      }
    };
    var lock = LockService.getScriptLock();
    lock.waitLock(10000);
    try { setLarge(PREFIX + "CURRENT", record); }
    finally { lock.releaseLock(); }
    return output({
      ok: true,
      action: "cache",
      version: record.version,
      sourceDate: record.sourceDate,
      cachedAt: record.cachedAt,
      checksum: record.checksum
    });
  }
  function getSummary(body) {
    var record = getLarge(PREFIX + "CURRENT");
    if (!record) return output({ ok: false, error: "No summary cache. Open V120 and run Sync + Verify first." });
    var slot = String(body.slot || "morning").toLowerCase() === "evening" ? "evening" : "morning";
    var text = normalizeLineBreaks(record.summaries && record.summaries[slot]);
    if (!text) return output({ ok: false, error: "Summary slot is unavailable: " + slot });
    var ageMinutes = Math.max(0, Math.round((Date.now() - new Date(record.cachedAt).getTime()) / 60000));
    return output({
      ok: true,
      action: "get",
      slot: slot,
      text: text,
      version: record.version,
      timeZone: record.timeZone,
      sourceDate: record.sourceDate,
      generatedAt: record.generatedAt,
      cachedAt: record.cachedAt,
      ageMinutes: ageMinutes,
      stale: ageMinutes > MAX_AGE_MINUTES,
      checksum: record.checksum
    });
  }
  function health() {
    var record = getLarge(PREFIX + "CURRENT");
    return output({
      ok: true,
      service: "QE V120 Scheduled Summary API",
      version: "120",
      configured: secret().length >= 12,
      cacheReady: !!record,
      cachedAt: record ? record.cachedAt : ""
    });
  }
  function route(body) {
    body = body || {};
    var action = String(body.action || "health").toLowerCase();
    if (action === "health") return health();
    if (!authorized(body.secret)) return output({ ok: false, error: "Unauthorized" });
    if (action === "cache") return cache(body);
    if (action === "get") return getSummary(body);
    return output({ ok: false, error: "Unknown action: " + action });
  }
  return { route: route, parsePost: parsePost, health: health };
})();

function doPost(e) {
  try { return QE_V120.route(QE_V120.parsePost(e)); }
  catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: String(err && err.message || err) }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function doGet(e) {
  /* GET is health-only so the secret never has to be placed in a URL/query string. */
  return QE_V120.health();
}
